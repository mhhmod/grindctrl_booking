      "text": "offer a manual search.",
      "raw_recognition": "offer a manual search.",
      "start": 109.5542403628118,
      "end": 111.21750566893425
    },
    {
      "source_start": 111.0975,
      "source_end": 112.554187,
      "text": "Multiple matches?",
      "raw_recognition": "Multiple matches?",
      "start": 111.21750566893425,
      "end": 112.67419501133787
    },
    {
      "source_start": 112.554187,
      "source_end": 115.179,
      "text": "Ask the agent to select the right record.",
      "raw_recognition": "Ask the agent to select the right record.",
