  "captions": [
    {
      "source_start": 0.0,
      "source_end": 2.3541565,
      "text": "A customer calls Concrete again.",
      "raw_recognition": "A customer calls concrete again.",
      "start": 0.12,
      "end": 2.474149659863946
    },
    {
      "source_start": 2.3541565,
      "source_end": 7.456625000000001,
      "text": "What should the next customer service agent know before asking the first question?",
      "raw_recognition": "What should the next customer service agent know before asking the first question?",
      "start": 2.474149659863946,
      "end": 7.576621315192744
    },
    {
      "source_start": 7.456625000000001,
      "source_end": 9.263125,
      "text": "Not just a phone number.",
      "raw_recognition": "Not just a phone number.",
      "start": 7.576621315192744,
      "end": 9.38312925170068
    },
    {
      "source_start": 9.263125,
      "source_end": 11.354094,
      "text": "but the correct customer profile",
      "raw_recognition": "but the correct customer profile",
      "start": 9.38312925170068,
      "end": 11.474104308390022
    },
    {
      "source_start": 11.354094,
      "source_end": 12.853563000000001,
      "text": "the available history,",
      "raw_recognition": "the available history,",
      "start": 11.474104308390022,
      "end": 12.973560090702946
    },
    {
      "source_start": 12.853563000000001,
      "source_end": 15.7957815,
      "text": "and the notes attached to previous calls.",
      "raw_recognition": "and the notes attached to previous calls.",
      "start": 12.973560090702946,
      "end": 15.915782312925169
    },
    {
      "source_start": 15.7957815,
      "source_end": 19.901875,
      "text": "Here's the second experience GRINDCTRL is proposing for Concrete.",
      "raw_recognition": "Here's the second experience grind control is proposing for concrete.",
      "start": 15.915782312925169,
      "end": 20.0218820861678
    },
    {
      "source_start": 19.901875,
      "source_end": 21.9461565,
      "text": "A clearer customer view.",
      "raw_recognition": "A clearer customer view.",
      "start": 20.0218820861678,
      "end": 22.066167800453517
    },
    {
      "source_start": 21.9461565,
      "source_end": 26.755906000000003,
      "text": "connected to incoming calls through Genesys and the appropriate Zoho records.",
      "raw_recognition": "connected to incoming calls through Genesis and the appropriate Zoho records.",
      "start": 22.066167800453517,
      "end": 26.87589569160998
    },
    {
      "source_start": 26.755906000000003,
      "source_end": 29.1901875,
      "text": "The caller number initiates a lookup.",
      "raw_recognition": "The caller number initiates a lookup.",
      "start": 26.87589569160998,
      "end": 29.310181405895694
    },
    {
      "source_start": 29.1901875,
      "source_end": 31.0928125,
      "text": "After a reliable match,",
      "raw_recognition": "After a reliable match,",
      "start": 29.310181405895694,
      "end": 31.21281179138322
    },
    {
      "source_start": 31.0928125,
      "source_end": 34.925812500000006,
      "text": "The agent sees the customer's name and permitted contact details.",
      "raw_recognition": "The agent sees the customer's name and permitted contact details.",
      "start": 31.21281179138322,
      "end": 35.04580498866213
    },
    {
      "source_start": 34.925812500000006,
      "source_end": 36.9326875,
      "text": "including email when available.",
      "raw_recognition": "including email when available.",
      "start": 35.04580498866213,
      "end": 37.05269841269841
    },
    {
      "source_start": 36.9326875,
      "source_end": 39.780437,
      "text": "Missing information is marked unavailable.",
      "raw_recognition": "Missing information is marked unavailable.",
      "start": 37.05269841269841,
      "end": 39.90043083900226
    },
    {
      "source_start": 39.780437,
      "source_end": 44.333656500000004,
      "text": "The same proposed view can show the customer segment from Concrete Icons Club.",
      "raw_recognition": "The same proposed view can show the customer segment from Concrete Icons Club.",
      "start": 39.90043083900226,
      "end": 44.453650793650795
    },
    {
      "source_start": 44.333656500000004,
      "source_end": 45.309312500000004,
      "text": "Lifestyle.",
      "raw_recognition": "Lifestyle.",
      "start": 44.453650793650795,
      "end": 45.429319727891155
    },
    {
      "source_start": 45.309312500000004,
      "source_end": 46.999375,
      "text": "Prestige or Elite.",
      "raw_recognition": "prestige or elite.",
      "start": 45.429319727891155,
      "end": 47.119365079365075
    },
    {
      "source_start": 46.999375,
      "source_end": 51.653000500000005,
      "text": "That membership information must come from a trusted, updated source.",
      "raw_recognition": "That membership information must come from a trusted, updated source.",
      "start": 47.119365079365075,
      "end": 51.77299319727891
    },
    {
      "source_start": 51.653000500000005,
      "source_end": 54.075937499999995,
      "text": "It cannot be guessed from the caller's number.",
      "raw_recognition": "It cannot be guessed from the caller's number.",
      "start": 51.77299319727891,
      "end": 54.1959410430839
    },
    {
      "source_start": 54.075937499999995,
      "source_end": 58.073468500000004,
      "text": "and no membership benefit should be assumed without confirmation.",
      "raw_recognition": "and no membership benefit should be assumed without confirmation.",
      "start": 54.1959410430839,
      "end": 58.1934693877551
    },
    {
      "source_start": 58.073468500000004,
      "source_end": 60.996812500000004,
      "text": "But a profile is only the starting point.",
      "raw_recognition": "But a profile is only the starting point.",
      "start": 58.1934693877551,
      "end": 61.11680272108843
    },
    {
      "source_start": 60.996812500000004,
      "source_end": 63.3459685,
      "text": "Call level history matters more.",
      "raw_recognition": "Call level history matters more.",
      "start": 61.11680272108843,
      "end": 63.46596371882086
    },
    {
      "source_start": 63.3459685,
      "source_end": 67.54009400000001,
      "text": "Imagine a simple timeline showing every available call activity.",
      "raw_recognition": "Imagine a simple timeline showing every available call activity.",
      "start": 63.46596371882086,
      "end": 67.66009070294785
    },
    {
      "source_start": 67.54009400000001,
      "source_end": 68.531656,
      "text": "Its date?",
      "raw_recognition": "Its date?",
      "start": 67.66009070294785,
      "end": 68.65165532879818
    },
    {
      "source_start": 68.531656,
      "source_end": 69.2950625,
      "text": "agent",
      "raw_recognition": "agent",
      "start": 68.65165532879818,
      "end": 69.4150566893424
    },
    {
      "source_start": 69.2950625,
      "source_end": 71.951656,
      "text": "and notes for that specific interaction.",
      "raw_recognition": "and notes for that specific interaction.",
      "start": 69.4150566893424,
      "end": 72.07165532879819
    },
    {
      "source_start": 71.951656,
      "source_end": 73.09231249999999,
      "text": "For example,",
      "raw_recognition": "For example,",
      "start": 72.07165532879819,
      "end": 73.21231292517007
    },
    {
      "source_start": 73.09231249999999,
      "source_end": 76.0968125,
      "text": "Last week's call concerned an exchange request.",
      "raw_recognition": "Last week's call concerned an exchange request.",
      "start": 73.21231292517007,
      "end": 76.21680272108844
    },
    {
      "source_start": 76.0968125,
      "source_end": 79.2775625,
      "text": "The employee recorded that the branch would review the matter.",
      "raw_recognition": "The employee recorded that the branch would review the matter.",
      "start": 76.21680272108844,
      "end": 79.39757369614513
    },
    {
      "source_start": 79.2775625,
      "source_end": 81.39834400000001,
      "text": "When the customer calls again today,",
      "raw_recognition": "When the customer calls again today,",
      "start": 79.39757369614513,
      "end": 81.51834467120182
    },
    {
      "source_start": 81.39834400000001,
      "source_end": 85.863,
      "text": "The new agent opens that particular call and reads its actual note.",
      "raw_recognition": "The new agent opens that particular call and reads its actual note.",
      "start": 81.51834467120182,
      "end": 85.98299319727892
    },
    {
      "source_start": 85.863,
      "source_end": 87.8557815,
      "text": "They see what was documented.",
      "raw_recognition": "They see what was documented.",
      "start": 85.98299319727892,
      "end": 87.97578231292518
    },
    {
      "source_start": 87.8557815,
      "source_end": 90.804625,
      "text": "Without confusing a call note with a ticket comment...",
      "raw_recognition": "Without confusing a call note with a ticket comment...",
      "start": 87.97578231292518,
      "end": 90.92462585034014
    },
    {
      "source_start": 90.804625,
      "source_end": 91.9140005,
      "text": "AI summary,",
      "raw_recognition": "AI summary,",
      "start": 90.92462585034014,
      "end": 92.03399092970523
    },
    {
      "source_start": 91.9140005,
      "source_end": 93.4388125,
      "text": "or a completed action.",
      "raw_recognition": "or a completed action.",
      "start": 92.03399092970523,
      "end": 93.55882086167802
    },
    {
      "source_start": 93.4388125,
      "source_end": 95.33375000000001,
      "text": "During today's conversation,",
      "raw_recognition": "During today's conversation,",
      "start": 93.55882086167802,
      "end": 95.45374149659864
    },
    {
      "source_start": 95.33375000000001,
      "source_end": 99.6317185,
      "text": "The agent records a new note against the right interaction if supported.",
      "raw_recognition": "The agent records a new note against the right interaction if supported.",
      "start": 95.45374149659864,
      "end": 99.75172335600908
    },
    {
      "source_start": 99.6317185,
      "source_end": 102.412844,
      "text": "Notes should belong to the call they describe.",
      "raw_recognition": "Notes should belong to the call they describe.",
      "start": 99.75172335600908,
      "end": 102.53283446712018
    },
    {
      "source_start": 102.412844,
      "source_end": 104.2030625,
      "text": "not a generic summary.",
      "raw_recognition": "not a generic summary.",
      "start": 102.53283446712018,
      "end": 104.3230612244898
    },
    {
      "source_start": 104.2030625,
      "source_end": 107.838438,
      "text": "And the interface must handle uncertainty honestly.",
      "raw_recognition": "And the interface must handle uncertainty honestly.",
      "start": 104.3230612244898,
      "end": 107.95843537414966
    },
    {
      "source_start": 107.838438,
      "source_end": 109.43424999999999,
      "text": "No matching contact?",
      "raw_recognition": "No matching contact?",
      "start": 107.95843537414966,
      "end": 109.5542403628118
    },
    {
      "source_start": 109.43424999999999,
