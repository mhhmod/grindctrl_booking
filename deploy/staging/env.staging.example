# Copy ONLY to /root/grindctrl-staging/.env.staging; chmod 600, root-owned.
# Plain dotenv, not a shell script. Never source it, commit it or log it.
# Values below are placeholders. Do not copy any production .env file.

# Staging identity; NODE_ENV=production means optimized Next, not live credentials.
GRINDCTRL_ENV=staging
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://shopify-m1-dev.grindctrl.cloud
GRINDCTRL_TEST_PREVIEW_ORIGIN=https://shopify-m1-dev.grindctrl.cloud
GRINDCTRL_TEST_SHOPS='["REPLACE-test-store-a.myshopify.com","REPLACE-test-store-b.myshopify.com"]'
# The shop list is intake/boot validation, NOT a route allowlist. See README limits.

# Clerk Development instance only. Public key must match the GitHub staging variable.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE
CLERK_SECRET_KEY=sk_test_REPLACE

# Separate, already-provisioned TEST Supabase; NEVER either production project.
# Public values must match GitHub staging variables used at build time.
# Owner decision 2026-10-31: staging shares the try-on production project. Set both lines together;
# the guard refuses that project without the override and always refuses the widget project.
STAGING_SHARED_PRODUCTION_SUPABASE_REF=prsusuwxbzaekynonifl
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_TEST_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_TEST_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_TEST_SERVICE_ROLE_OR_SECRET_KEY

# Legitimate TEST app registrations only, max 2. JSON format consumed by app-registry.ts.
# Replace both clientId and secret; omit B if only A is available, never invent B.
SHOPIFY_APPS='[{"clientId":"REPLACE_TEST_A_CLIENT_ID","secret":"REPLACE_TEST_A_SECRET"},{"clientId":"REPLACE_TEST_B_CLIENT_ID","secret":"REPLACE_TEST_B_SECRET"}]'
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_TOKEN_ENC_KEY=REPLACE_WITH_NEW_BASE64_32_BYTES
# Signs storefront origin tokens for the chat panel. Unique to staging, 32+ characters.
GRINDCTRL_CAPABILITY_SECRET=REPLACE_WITH_NEW_STAGING_ONLY_SECRET_32_PLUS_CHARS
SHOPIFY_PRIVACY_PROCESSING_ENABLED=false

# Existing non-charging runner. All AI provider credentials and bridge targets absent.
TRYON_MODE=mock
LANDING_SANDBOX_MODE=mock
OPENROUTER_API_KEY=
GROQ_API_KEY=
LANDING_TRIAL_INFLOW_URL=
LANDING_TRIAL_INFLOW_TOKEN=
TRYON_TEMP_LEGACY_STOREFRONT_COMPAT=disabled
TRYON_TEST_LOOKS_PER_DAY=12
# No manual credit grants; TEST database must already have <=2 stores, 12 credits each.
TRYON_PLATFORM_OPERATOR_CLERK_IDS=

# Internal real Redis + SRH. Generate two DISTINCT 64-character lowercase hex values.
# This is the same REST adapter contract used by the original strict shared limiter.
UPSTASH_REDIS_REST_URL=http://srh:8080
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_NEW_HEX_32_BYTES
STAGING_REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_NEW_HEX_32_BYTES

# Optional TEST SMTP inbox only. Empty disables email. No live campaigns or schedules.
TRYON_EMAIL_SMTP_HOST=
TRYON_EMAIL_SMTP_PORT=587
TRYON_EMAIL_SMTP_USER=
TRYON_EMAIL_SMTP_APP_PASSWORD=
TRYON_EMAIL_FROM_NAME=GRINDCTRL Staging
STORE_CHAT_EMAIL_FROM_NAME=GRINDCTRL Staging Store Chat
TRYON_EMAIL_REPLY_TO=
TRYON_EMAIL_LIVE_DEMO_URL=https://shopify-m1-dev.grindctrl.cloud/try-on
TRYON_EMAIL_SEND_TOKEN=
TRYON_EMAIL_LIVE_SEND_ENABLED=false

# Optional maintenance credentials, disabled by default; no production schedulers.
# If needed later, generate unique staging values; never reuse repository secrets.
TRYON_CLEANUP_SECRET=
MESSENGER_ALERTS_SECRET=

# No production analytics/monitoring. These stay empty in the staging Docker build too.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_TELEMETRY_DISABLED=1
# Do not set SENTRY_RELEASE or STAGING_BUILT_* here; they belong to the image.
