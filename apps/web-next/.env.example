# ─── App URL ───
# Local: http://localhost:3000
# Production: https://grindctrl.cloud
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Landing Playground Mode ───
# Server-only. Default: mock. Set to "live" to call the n8n trial inflow bridge.
LANDING_SANDBOX_MODE="mock"
LANDING_TRIAL_INFLOW_URL="https://YOUR_N8N_DOMAIN/webhook/grindctrl-trial-inflow"
LANDING_TRIAL_INFLOW_TOKEN="replace-with-server-only-token"
LANDING_TRIAL_INFLOW_TIMEOUT_MS="12000"

# ─── Clerk Authentication ───
# Development: use pk_test_ / sk_test_ keys from Clerk dashboard
# Production:  use pk_live_ / sk_live_ keys (NEVER commit live keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxx"
CLERK_SECRET_KEY="sk_test_xxxxx"

# ─── Supabase (production project: prsusuwxbzaekynonifl, see docs/deployment.md) ───
# Same project for both dev and prod — RLS handles access control
NEXT_PUBLIC_SUPABASE_URL="https://prsusuwxbzaekynonifl.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Bypasses RLS; used by the try-on, billing and Store Chat routes.
SUPABASE_SERVICE_ROLE_KEY=""

# ─── Try-on image generation (server-only) ───
# "live" calls OpenRouter; anything else keeps try-on in mock mode.
# Every try-on image uses meta/muse-image on every plan (lib/try-on/models.ts);
# there is no model setting. scripts/production-readiness-preflight.mjs at the
# repo root checks that OpenRouter still lists it.
TRYON_MODE=""
OPENROUTER_API_KEY=""

# ─── Shopify app(s) (server-only) ───
# Signs try-on sessions and verifies app proxy requests, webhooks, OAuth
# callbacks, and embedded-admin session tokens. Try-on and Store Chat routes
# answer 503 without at least one app configured.
#
# Single app (today's default): set the pair below. SHOPIFY_API_KEY is the
# client_id from shopify.app.toml; SHOPIFY_API_SECRET is that app's secret
# from the Partner Dashboard.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
#
# Additional per-store custom apps (lib/shopify/app-registry.ts): set
# SHOPIFY_APPS to a JSON array, one {clientId, secret} object per app, e.g.
#   SHOPIFY_APPS='[{"clientId":"...","secret":"..."},{"clientId":"...","secret":"..."}]'
# SHOPIFY_API_KEY/SHOPIFY_API_SECRET above still work as a fallback entry, so
# an existing single-app deployment needs no change. Every verification path
# (OAuth, HMAC, app proxy signatures, session tokens, webhooks) checks all
# configured apps and resolves to whichever one actually signed the request.
#
# To add a new app, the owner:
#   1. Creates the custom app in the Partner Dashboard for that store, with
#      the same app proxy subpath and callback URLs as the existing app
#      (see apps/grindctrl-tryon/shopify.app.toml).
#   2. Adds its {clientId, secret} to the SHOPIFY_APPS JSON array above and
#      redeploys. No other server change is required.
#   3. Installs it on that store via the Partner Dashboard install link.
# The embedded-admin shell (app/shopify/app/[[...rest]]/page.tsx) still
# loads as the primary (first-listed) app; routing a given shop's embedded
# admin at the specific app it installed is not yet implemented.

# ─── Groq (server-only) ───
# Site assistant replies, speech to text and text to speech. Store Chat
# replies go through OpenRouter (OPENROUTER_API_KEY above).
GROQ_API_KEY=""

# GrindCTRL Try-On campaign email (server-only)
TRYON_EMAIL_SMTP_HOST="smtp.gmail.com"
TRYON_EMAIL_SMTP_PORT="587"
TRYON_EMAIL_SMTP_USER="grindctrlnow@gmail.com"
TRYON_EMAIL_SMTP_APP_PASSWORD="replace-with-google-app-password"
TRYON_EMAIL_FROM_NAME="GrindCTRL Try-On"
# Sender name on Store Chat handoff alerts. Same mailbox as TRYON_EMAIL_SMTP_USER above.
STORE_CHAT_EMAIL_FROM_NAME="GRINDCTRL Store Chat"
TRYON_EMAIL_REPLY_TO="grindctrlnow@gmail.com"
TRYON_EMAIL_LIVE_DEMO_URL="https://grindctrl.cloud/try-on"
TRYON_EMAIL_SEND_TOKEN="replace-with-a-long-random-server-token"
# Keep false until STOP suppression, idempotency, and an approved campaign lead resolver are connected.
TRYON_EMAIL_LIVE_SEND_ENABLED="false"

# Mandatory Shopify privacy webhooks (server-only). Default OFF: only the
# exact string 'true' enables immediate redaction and customer data exports.
# Disabled requests are still recorded and emailed for manual handling.
# Apply 20260909_shopify_privacy_requests.sql before deploying the receiver.
# Uses the existing TRYON_EMAIL_SMTP_* mailbox; no separate alert account.
# Enabling this flag does not replay previously recorded requests.
SHOPIFY_PRIVACY_PROCESSING_ENABLED="false"

# Temporary zero-downtime bridge only: defaults fail-closed for any value
# except the exact opt-in below. Compatibility sessions are signed, shopless,
# rate-limited, and platform-funded/mock only; they can never reserve or debit
# merchant credits. Enable only during backend -> Shopify extension ->
# enforcement rollout, with Upstash rate limiting configured, then remove it
# from the environment. Compatibility fails closed if the limiter is absent.
TRYON_TEMP_LEGACY_STOREFRONT_COMPAT="disabled"
# Temporary opt-in value: allow-unsigned-nonbillable-storefront

# Server-only bearer used exclusively by the external durable-result cleanup
# workflow. Generate at least 32 random bytes, configure the same value in the
# deployed app and the GitHub Actions TRYON_CLEANUP_SECRET repository secret,
# and rotate both ends together. Never prefix this with NEXT_PUBLIC_.
TRYON_CLEANUP_SECRET="replace-with-at-least-32-random-bytes"

# Manual Try-On credit/plan grants are platform-operator only. Empty disables
# all manual grants. Comma-separated Clerk user IDs, never email addresses.
TRYON_PLATFORM_OPERATOR_CLERK_IDS=""

# ─── Upstash Redis (distributed abuse and assistant budget enforcement) ───
# Missing/unavailable Redis denies protected requests with safe 503 responses;
# it never authorizes paid provider work or merchant writes without a limit.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"

# ─── Client-side observability (MUST be present at build time) ───
# Next.js inlines NEXT_PUBLIC_* into client bundles during `next build`.
# The Docker build receives these as --build-arg from GitHub Actions secrets;
# runtime-only values never reach the browser. See deploy-next.yml.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
