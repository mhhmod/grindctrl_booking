{% comment %}
  GRINDCTRL Support Messenger — app embed block.

  Renders the tiny loader script. No theme CSS/JS is touched; the launcher
  lives in its own shadow root and the messenger opens inside an iframe.

  The shop's permanent domain is the only identifier the merchant needs —
  there is no key to paste. GRINDCTRL resolves the store's configuration
  from it server-side.

  Only the signed-in customer's id is rendered, and only as a hint for the
  loader to ask the Shopify App Proxy for a token. The proxy takes who is
  signed in from Shopify's own signed parameters, never from this page, so
  the browser can never forge identity. No email or name is printed here.
{% endcomment %}

{% unless block.settings.disable_on_this_page %}
  {% assign app_origin = app.metafields.grindctrl.app_origin.value | default: 'https://grindctrl.cloud' %}
  {% assign app_origin_prefix = app_origin | slice: 0, 8 %}
  {% unless app_origin_prefix == 'https://' %}
    {% assign app_origin = 'https://grindctrl.cloud' %}
  {% endunless %}
  <script
    async
    src="{{ app_origin | escape }}/widget/v1/messenger.js"
    data-proxy-path="{{ block.settings.proxy_path | default: '/apps/grindctrl' | escape }}"
    data-shop="{{ shop.permanent_domain }}"
    data-locale="{{ request.locale.iso_code | slice: 0, 2 }}"
    {% if customer %}
      data-customer-id="{{ customer.id | escape }}"
    {% endif %}
  ></script>
{% endunless %}

{% schema %}
{
  "name": "GRINDCTRL Store Chat",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "proxy_path",
      "label": "Store connection path",
      "info": "Must match this app's App Proxy URL in Shopify. Keep different paths for overlapping connections.",
      "default": "/apps/grindctrl"
    },
    {
      "type": "checkbox",
      "id": "disable_on_this_page",
      "label": "Hide the messenger",
      "info": "Turn this on to temporarily hide support chat without uninstalling.",
      "default": false
    }
  ]
}
{% endschema %}
