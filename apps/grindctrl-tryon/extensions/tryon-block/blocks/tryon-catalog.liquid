{% comment %}
  GrindCTRL Try-On catalog embed: adds a "Try on" button to every product
  card in collection/catalog grids. Clicking opens a dialog with the same
  try-on experience (same settings, colors, and journey as the product-
  page block). Enable under Theme settings -> App embeds.
{% endcomment %}
{% assign app_origin = app.metafields.grindctrl.app_origin.value | default: 'https://grindctrl.cloud' %}
{% assign app_origin_prefix = app_origin | slice: 0, 8 %}
{% unless app_origin_prefix == 'https://' %}
  {% assign app_origin = 'https://grindctrl.cloud' %}
{% endunless %}
<script
  src="{{ 'tryon-catalog.js' | asset_url }}"
  defer
  data-app-origin="{{ app_origin | escape }}"
  data-gc-proxy-path="{{ block.settings.proxy_path | default: '/apps/grindctrl' | escape }}"
  data-gc-shop="{{ shop.permanent_domain }}"
  data-gc-locale="{{ request.locale.iso_code }}"
></script>

{% schema %}
{
  "name": "Try-On on product cards",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "proxy_path",
      "label": "Store connection path",
      "info": "Must match this app's App Proxy URL in Shopify. Keep different paths for overlapping connections.",
      "default": "/apps/grindctrl"
    }
  ]
}
{% endschema %}
